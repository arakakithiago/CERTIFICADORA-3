const pool = require('../config/db');

async function obterIndicadores(req, res) {
    try {
        const meninasResult = await pool.query(`SELECT COUNT(*) as total FROM menina`);
        const oficinasResult = await pool.query(`SELECT COUNT(*) as total FROM oficinas`);
        const inscricoesResult = await pool.query(`SELECT COUNT(*) as total FROM inscricoes`);

        res.status(200).json({
            indicadores: {
                totalMeninas: parseInt(meninasResult.rows[0].total),
                totalOficinas: parseInt(oficinasResult.rows[0].total),
                totalInscricoes: parseInt(inscricoesResult.rows[0].total)
            }
        });
    } catch (erro) {
        console.error(erro);
        res.status(500).json({ erro: 'Erro ao carregar o painel de indicadores.' });
    }
}

module.exports = { obterIndicadores };